# HW Desk — copy to .env and fill in. Never commit the real file.
HWDESK_SECRET_KEY=change-me-long-random
HWDESK_DATABASE=/var/lib/hwdesk/hwdesk.db
HWDESK_BASE_URL=https://hwdesk.firma.cz
HWDESK_COMPANY_NAME=Firma s.r.o.
HWDESK_ADMIN_EMAILS=it@firma.cz,spravce@firma.cz
HWDESK_API_KEYS=long-random-key-for-hr-sync
HWDESK_PROTOCOL_COPY_TO=it@firma.cz

# Microsoft 365 login (Entra ID app registration: Web platform, redirect URI = BASE_URL + /auth/callback)
HWDESK_AUTH_MODE=oidc
HWDESK_OIDC_TENANT_ID=
HWDESK_OIDC_CLIENT_ID=
HWDESK_OIDC_CLIENT_SECRET=

# E-mail (Microsoft 365 SMTP AUTH or any SMTP relay)
HWDESK_EMAIL_MODE=smtp
HWDESK_EMAIL_FROM=hwdesk@firma.cz
HWDESK_SMTP_HOST=smtp.office365.com
HWDESK_SMTP_PORT=587
HWDESK_SMTP_USER=hwdesk@firma.cz
HWDESK_SMTP_PASSWORD=
HWDESK_SMTP_STARTTLS=1

HWDESK_HANDOVER_TOKEN_HOURS=168
HWDESK_PROTOCOL_DIR=/var/lib/hwdesk/protocols
